# Salin file ini menjadi .env lalu isi nilainya.  JANGAN commit file .env!

# Port web server (frontend + API)
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=certificate_registry

# Blockchain (Hardhat Local Network)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Isi keduanya dengan string acak BERBEDA, masing-masing minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN menaruh rahasia asli di file ini (file ini ikut di-commit).
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
RECIPIENT_SECRET=ganti_dengan_string_acak_minimal_32_karakter_lain

# Masa berlaku token login (detik)
JWT_EXPIRES_IN=3600
